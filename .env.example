# ============================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ VERCEL (mono-pay)
# Это шаблон: реальные токены и реальные секреты в GitHub не хранить.
# ============================================================

SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here
SHOPIFY_ACCESS_TOKEN=

SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_REDIRECT_URL=https://your-store.myshopify.com/pages/thank-you
SHOPIFY_API_VERSION=2026-07

# Package Commerce Contract v1.0.
# Можно указывать числовой Variant ID или полный gid://shopify/ProductVariant/...
PACKAGE_PRODUCT_VARIANT_ID=your_main_set_variant_id

# Ровно три разрешённых VIP-подарка. Клиент не может подменить их произвольным товаром.
VIP_GIFT_1_VARIANT_ID=your_aloe_lips_variant_id
VIP_GIFT_2_VARIANT_ID=your_aloe_avocado_soap_variant_id
VIP_GIFT_3_VARIANT_ID=your_deodorant_variant_id

MONOBANK_API_TOKEN=your_monobank_merchant_token_here
MONOBANK_INVOICE_VALIDITY_SEC=86400

APP_URL=https://your-project.vercel.app
ALLOWED_ORIGINS=https://your-store.myshopify.com
